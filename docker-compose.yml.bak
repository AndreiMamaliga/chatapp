services:
  nginx:
    image: nginx:latest
    ports: ["80:80"]
    volumes:
      - ./html:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on: [php]
    restart: always
  php:
    build: .
    volumes:
      - ./html:/usr/share/nginx/html:ro
    depends_on: [mysql]
    restart: always
  mysql:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: 1ccc7f92ce1be8460d3bf3ee
      MYSQL_DATABASE: chatdb
      MYSQL_USER: chat
      MYSQL_PASSWORD: 27bd787d057a2023903d30b7
    volumes:
      - db:/var/lib/mysql
      - ./initdb:/docker-entrypoint-initdb.d:ro
    restart: always
volumes:
  db:
